// MVP schema for the client portal — see the "Data model" and "Phasing"
// sections of the technical spec. SLA/e-signature is deferred (vendor not
// chosen yet), so there's no SLA model here.
//
// User/Session/Account/Verification live in Neon's own `neon_auth` schema
// (Managed Better Auth) — not modeled here, and not something we introspect
// or migrate. UserProfile below is our own extension table, joined by id to
// whatever the neon_auth user id is, since Managed Auth doesn't support
// custom fields on its user model.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved the connection URL out of here and into prisma.config.ts
// (for the CLI) plus a driver adapter (for the runtime client) — see both
// in this package. `provider` is still declared here; `url` is not.
datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum RequestStatus {
  SUBMITTED
  ESTIMATED
  APPROVED
  IN_PROGRESS
  DONE
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SizeTier {
  SMALL
  MEDIUM
  LARGE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Client {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  profiles UserProfile[]

  @@map("clients")
}

enum Role {
  ADMIN
  CLIENT
}

// Extends the neon_auth user with what this app actually needs to know:
// which side of the fence they're on, and (for a client) which tenant.
// `id` is not generated here — it's set to match the neon_auth user's id
// when the profile row is created (e.g. on first sign-in), never on its own.
model UserProfile {
  id        String   @id
  role      Role     @default(CLIENT)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("user_profiles")
}

model Project {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  milestones     Milestone[]
  changeRequests ChangeRequest[]
  bugReports     BugReport[]
  invoices       Invoice[]

  @@index([clientId])
  @@map("projects")
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId])
  @@map("milestones")
}

model ChangeRequest {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      RequestStatus @default(SUBMITTED)
  sizeTier    SizeTier?
  estimate    Estimate?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId])
  @@map("change_requests")
}

model BugReport {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String
  severity      BugSeverity   @default(MEDIUM)
  screenshotUrl String?
  status        RequestStatus @default(SUBMITTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId])
  @@map("bug_reports")
}

// One-to-one with ChangeRequest: the formula-derived draft the site owner
// confirms before a client ever sees a number (see "Real-time cost
// estimation" in the spec).
model Estimate {
  id              String        @id @default(cuid())
  changeRequestId String        @unique
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  hours           Decimal
  amount          Decimal
  confirmed       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("estimates")
}

// Mirrors a Stripe invoice; this table is never the source of truth for
// payment state, Stripe is (see "Invoicing" in the spec).
model Invoice {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stripeInvoiceId String        @unique
  status          InvoiceStatus @default(DRAFT)
  amount          Decimal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@map("invoices")
}
