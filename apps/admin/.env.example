# Required. 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Where the app is served; used to build magic-link URLs.
BETTER_AUTH_URL=http://localhost:3001
# The one address that can sign in (created by `pnpm db:seed`).
ADMIN_EMAIL=hello@dainemawer.com

# Optional locally — leave unset to use PGlite in .data/pglite.
DATABASE_URL=
# Optional locally — leave unset to print emails to the dev server log.
RESEND_API_KEY=
MAIL_FROM="Daine Mawer <billing@dainemawer.com>"
# Optional locally — leave unset to keep sent-PDF snapshots in .data/snapshots.
BLOB_READ_WRITE_TOKEN=
