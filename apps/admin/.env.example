# Required. 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Where the app is served; used to build magic-link URLs.
BETTER_AUTH_URL=http://localhost:3001
# The one address that can sign in (created by `pnpm db:seed`).
ADMIN_EMAIL=hello@dainemawer.com
# Recovery only: email sign-in links stop once a passkey exists. Set to 1
# (then redeploy) if every passkey is lost, and remove it once you're back in.
# ALLOW_EMAIL_SIGN_IN=1

# Production/preview only (set by the Neon integration). `pnpm dev` runs its
# own local Postgres and ignores this file's value.
DATABASE_URL=
# Optional locally — leave unset to print emails to the dev server log.
RESEND_API_KEY=
MAIL_FROM="Daine Mawer <billing@dainemawer.com>"
# Optional locally — leave unset to keep sent-PDF snapshots in .data/snapshots.
BLOB_READ_WRITE_TOKEN=
# Bearer secret Vercel Cron sends to /api/cron/recurring and
# /api/cron/expenses. Unset = they refuse everything. Locally: set it, then
# curl -H "Authorization: Bearer $CRON_SECRET" localhost:3001/api/cron/recurring
CRON_SECRET=

# Investec Programmable Banking (Investec Online → Programmable Banking;
# the API key needs the accounts, balances and transactions scopes). The
# values below are Investec's public sandbox, which returns mock accounts
# and transactions; production leaves INVESTEC_BASE_URL unset.
INVESTEC_BASE_URL=https://openapisandbox.investec.com
INVESTEC_CLIENT_ID=yAxzQRFX97vOcyQAwluEU6H6ePxMA5eY
INVESTEC_CLIENT_SECRET=4dY0PjEYqoBrZ99r
INVESTEC_API_KEY=eUF4elFSRlg5N3ZPY3lRQXdsdUVVNkg2ZVB4TUE1ZVk6YVc1MlpYTjBaV010ZW1FdGNHSXRZV05qYjNWdWRITXRjMkZ1WkdKdmVBPT0=
# Optional locally — on Vercel the AI Gateway authenticates by itself. Leave
# unset to classify with offline keyword matching instead of Claude.
AI_GATEWAY_API_KEY=

# Linear (Settings → Security & access → Personal API keys, read-only) for
# /projects. Unset locally = sample data. LINEAR_TEAM_KEY (e.g. YIELD)
# limits it to one team. LINEAR_WEBHOOK_SECRET is the signing secret of the
# webhook pointed at /api/webhooks/linear, which refreshes /projects as soon
# as a project changes; without it, changes show within the hour.
LINEAR_API_KEY=
LINEAR_TEAM_KEY=
LINEAR_WEBHOOK_SECRET=

# Optional — Telegram notifications alongside the admin emails. Create a bot
# with @BotFather (its token goes here), message it once, then run
# `pnpm --filter admin telegram:chat-id` for your chat ID. Unset = messages
# are printed to the dev server log instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — the dashboard's calendar. Each is a Google Calendar "Secret
# address in iCal format" (Settings → the calendar → Integrate calendar).
# The URL is the credential: keep it out of the repo. Unset = not shown.
CALENDAR_WORK_URL=
CALENDAR_PERSONAL_URL=
