{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate; fi && pnpm build",
  "ignoreCommand": "npx turbo-ignore",
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/expenses",
      "schedule": "0 4 * * *"
    }
  ]
}
